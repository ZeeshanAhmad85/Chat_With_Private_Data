# ==============================================================================
# PrivateData-RAG Environment Configuration
# ==============================================================================
# Copy this file to '.env' and populate credentials as needed.
# Note: The system operates 100% locally by default without requiring any API keys.
# ==============================================================================

# --- Optional Cloud LLM Generation (OpenAI) ---
# If left blank or omitted, the application runs in 100% Local Offline Grounded mode.
OPENAI_API_KEY=your_openai_api_key_here
# Legacy alias:
API_KEY=your_openai_api_key_here

# --- Optional Vector Database (Qdrant Cloud or Local Container) ---
# If left blank, the application uses the built-in LocalVectorStore (NumPy + JSON persistence).
QDRANT_URL=https://your-cluster-url.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
# Legacy alias:
DB_API_KEY=your_qdrant_api_key_here

# --- Local Storage Configuration ---
VECTOR_STORE_DIR=./data/vector_store
